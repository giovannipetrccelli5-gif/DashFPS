{
  "schemaVersion": 1,
  "id": "dashfps",
  "version": "${version}",
  "name": "DashFPS",
  "description": "Client-side FPS optimization, dynamic render distance, and aggressive culling for Minecraft 26.3.",
  "authors": ["giovannipetrccelli5-gif"],
  "contact": {
    "sources": "https://github.com/giovannipetrccelli5-gif/DashFPS"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.dashfps.DashFPS"
    ]
  },
  "mixins": [
    {
      "config": "dashfps.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
